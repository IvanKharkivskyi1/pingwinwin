@host = http://localhost:3001
@userId = ea69b6cb-011c-416e-beec-cd3b71aee9e0

### Health
GET {{host}}/health

###

### Register user
POST {{host}}/auth/register
Content-Type: application/json

{
  "email": "auth-test@example.com",
  "name": "Auth Test",
  "password": "Test123456"
}

###

### Register duplicate user
POST {{host}}/auth/register
Content-Type: application/json

{
  "email": "auth-test@example.com",
  "name": "Auth Test",
  "password": "Test123456"
}

###

### Login with correct password
# @name login
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "auth-test@example.com",
  "password": "Test123456"
}

###

### Get my profile
GET {{host}}/auth/me
Authorization: Bearer {{login.response.body.accessToken}}

###

### Login with wrong password
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "auth-test@example.com",
  "password": "WrongPassword"
}

###

### Login with normalized email
POST {{host}}/auth/login
Content-Type: application/json

{
  "email": "  AUTH-TEST@EXAMPLE.COM  ",
  "password": "Test123456"
}

###

### Get users
GET {{host}}/users
Authorization: Bearer {{login.response.body.accessToken}}

###

### Create user
POST {{host}}/users
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "email": "ivan@example.com",
  "name": "Duplicate Test"
}

###

### Update user
PATCH {{host}}/users/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{login.response.body.accessToken}}
Content-Type: application/json

{
  "name": "Ghost User"
}

###

### Delete user
DELETE {{host}}/users/{{userId}}
Authorization: Bearer {{login.response.body.accessToken}}
